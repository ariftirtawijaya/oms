# =====================================================================
# CONTOH konfigurasi Nginx UTAMA VPS untuk relaylab.id (multi-project)
# Simpan sebagai /etc/nginx/sites-available/relaylab.id
# Bagian landing page & presensi hanya contoh: SESUAIKAN dengan konfigurasi
# yang sudah Anda punya. Yang wajib ditambahkan untuk OMS hanya blok "RelayLab OMS".
# HTTPS dibuat oleh: sudo certbot --nginx -d relaylab.id -d www.relaylab.id
# =====================================================================

upstream relaylab_oms_frontend { server 127.0.0.1:8100; keepalive 8; }
upstream relaylab_oms_backend  { server 127.0.0.1:8101; keepalive 8; }

server {
    listen 80;
    server_name relaylab.id www.relaylab.id;
    # certbot --nginx akan menambahkan blok 443 + redirect HTTPS otomatis

    # ---------- Landing page (contoh) ----------
    root /var/www/relaylab-landing;
    index index.html index.php;
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ---------- Sistem Presensi PHP (contoh, sesuaikan) ----------
    location ^~ /presensi/ {
        alias /var/www/presensi/public/;
        index index.php;
        try_files $uri $uri/ @presensi;
        location ~ \.php$ {
            include snippets/fastcgi-php.conf;
            fastcgi_param SCRIPT_FILENAME $request_filename;
            fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        }
    }
    location @presensi { rewrite ^/presensi/(.*)$ /presensi/index.php?$args last; }

    # ================= RelayLab OMS (/order/) =================
    location = /order { return 301 /order/; }

    # API FastAPI: /order/api/xxx -> backend /api/xxx (prefix /order dibuang sekali di sini)
    location ^~ /order/api/ {
        proxy_pass http://relaylab_oms_backend/api/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        client_max_body_size 10m;
    }

    # Frontend React statis: /order/xxx -> kontainer frontend /xxx (refresh halaman aman)
    location ^~ /order/ {
        proxy_pass http://relaylab_oms_frontend/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }
    # ================= akhir RelayLab OMS =================
}
