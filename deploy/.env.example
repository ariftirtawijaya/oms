# RelayLab OMS - template environment production.
# Salin: cp .env.example .env  lalu ganti SEMUA nilai GANTI_/ISI_. File .env tidak boleh di-commit.

# ===== Frontend & base path =====
# Subdirektori OMS. Frontend memanggil API secara same-origin di ${OMS_BASE_PATH}/api,
# sehingga https://103.247.9.189/order/ dan https://relaylab.id/order/ memakai build yang sama.
OMS_BASE_PATH=/order
# Cookie sesi hanya berlaku di /order (tidak bercampur dengan /stock/ atau landing page)
COOKIE_PATH=/order
# Origin yang diizinkan (pisahkan koma). Same-origin tidak memerlukan CORS, tetapi isi keduanya untuk berjaga-jaga.
CORS_ORIGINS=https://relaylab.id,https://www.relaylab.id,https://103.247.9.189

# Port lokal (hanya 127.0.0.1) yang diteruskan oleh Nginx utama VPS. Ubah bila bentrok.
OMS_FRONTEND_PORT=8100
OMS_BACKEND_PORT=8101

# ===== MongoDB (khusus OMS, hanya jaringan internal Docker) =====
MONGO_ROOT_USER=relaylab
# Buat dengan: openssl rand -hex 24
MONGO_ROOT_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT
DB_NAME=relaylab_oms

# ===== JWT & sesi =====
# Buat dengan: openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_STRING_ACAK_64_KARAKTER
# Wajib true karena OMS diakses lewat HTTPS
COOKIE_SECURE=true
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# ===== Akun Super Admin awal (dibuat sekali bila belum ada) =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=GANTI_PASSWORD_ADMIN_AWAL
ADMIN_NAME=Super Admin

# ===== Upload foto resi =====
# UPLOAD_DIR diset otomatis oleh docker-compose (/data/uploads -> deploy/data/uploads)
MAX_UPLOAD_MB=5

# ===== WhatsApp Fonnte =====
# simulation = pesan hanya dicatat di log (tidak dikirim), live = dikirim ke Fonnte
WHATSAPP_MODE=simulation
FONNTE_API_URL=https://api.fonnte.com/send
FONNTE_TOKEN=ISI_TOKEN_FONNTE
# Nomor admin, boleh lebih dari satu dipisah koma. Juga whitelist command /pengumuman.
FONNTE_ADMIN_WA=628xxxxxxxxxx
FONNTE_GROUP_ID=628xxxxxxxxxx-xxxxxxxxxx@g.us
# Sangat disarankan. URL webhook: https://relaylab.id/order/api/webhooks/fonnte?secret=NILAI_INI
FONNTE_WEBHOOK_SECRET=GANTI_DENGAN_STRING_ACAK
NOTIF_MAX_ATTEMPTS=5
